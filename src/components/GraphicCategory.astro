---
import PlotFigure from './PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import pizzaData from '../assets/pizza.json';

const { categoryName } = Astro.props;

const filteredPizza = pizzaData
  .filter((p: any) => p.category === categoryName)
  .map((p: any) => ({
    name: p.name,
    price: Number(p.price),
    orders: Number(p.orders),
    category: p.category
  }));

const options = {
  grid: true,
  inset: 10,
  x: { 
    label: "Prix ($)",
    domain: [10, 28] 
  },
  y: { 
    label: "Nombre de commandes",
    domain: [0, 450] 
  },
  marks: [
    Plot.frame({ stroke: "#e2e8f0" }),
    Plot.dot(filteredPizza, { 
      x: "price", 
      y: "orders", 
      fill: "category",
      r: 4,
      tip: true
    })
  ]
};
---

<section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
  <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
    <div>
      <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Catégorie : {categoryName}</h2>
      <p class="text-xs text-slate-500">Commandes en fonction du prix</p>
    </div>
    <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md border border-slate-200/80">
      {filteredPizza.length} entrées
    </span>
  </div>

  <div class="overflow-x-auto">
    <PlotFigure options={options} />
  </div>

  <footer class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
    <span>Données : Ventes de Pizzas</span>
    <span>Composant <code>GraphicCategory.astro</code></span>
  </footer>
</section>