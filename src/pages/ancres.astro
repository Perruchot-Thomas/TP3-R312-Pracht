---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
import '../styles/global.css';

const cleanData = (speciesName) => penguins
  .filter((p: any) => p.species === speciesName && p.culmen_length_mm !== "NaN" && p.culmen_depth_mm !== "NaN")
  .map((p: any) => ({
    species: p.species,
    culmen_length_mm: Number(p.culmen_length_mm),
    culmen_depth_mm: Number(p.culmen_depth_mm)
  }));

const penguinsAdelie = cleanData("Adelie");
const penguinsGentoo = cleanData("Gentoo");
const penguinsChinstrap = cleanData("Chinstrap");

const getPlotOptions = (data, title) => ({
  grid: true, inset: 10,
  x: { label: "Longueur du bec (mm)", domain: [30, 62] },
  y: { label: "Profondeur du bec (mm)", domain: [12, 22] },
  marks: [Plot.frame({ stroke: "#e2e8f0" }), Plot.dot(data, { x: "culmen_length_mm", y: "culmen_depth_mm", fill: "species", r: 4 })],
});
---

<Layout title="TP3 - Ancres Pingouins">
  <div class="max-w-4xl mx-auto p-8 bg-white rounded-2xl border border-slate-200/80 shadow-sm mt-12 mb-12">
    
    <div class="flex items-center justify-between mb-8 border-b border-slate-100 pb-6">
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900">Slider Pingouins (Ancres)</h1>
      </div>
      <a href="/" class="text-xs font-semibold px-4 py-2.5 rounded-xl bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200/60 transition">← Retour</a>
    </div>

    <div class="mb-8 flex items-center gap-4">
      <label for="anchors-menu" class="text-sm font-semibold text-slate-700">Espèce :</label>
      <select id="anchors-menu" class="px-4 py-2 rounded-lg bg-white border border-slate-200 shadow-sm focus:ring-2 focus:ring-indigo-500">
        <option value="#adelie">Adelie</option>
        <option value="#gentoo">Gentoo</option>
        <option value="#chinstrap">Chinstrap</option>
      </select>
    </div>

    <div class="slider-container flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-8 no-scrollbar">
      <div id="adelie" class="item min-w-full snap-center"><PlotFigure options={getPlotOptions(penguinsAdelie, "Adelie")} /></div>
      <div id="gentoo" class="item min-w-full snap-center"><PlotFigure options={getPlotOptions(penguinsGentoo, "Gentoo")} /></div>
      <div id="chinstrap" class="item min-w-full snap-center"><PlotFigure options={getPlotOptions(penguinsChinstrap, "Chinstrap")} /></div>
    </div>
  </div>

  <script>
    document.querySelector("#anchors-menu")?.addEventListener("change", (evt) => {
      const value = (evt.target as HTMLSelectElement).value;
      location.hash = value;
    });
  </script>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>