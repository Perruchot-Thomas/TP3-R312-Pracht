---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import pizzaData from "../assets/pizza.json";
import '../styles/global.css';

const cleanData = (catName) => pizzaData
  .filter((p: any) => p.category === catName)
  .map((p: any) => ({
    name: p.name,
    price: Number(p.price),
    orders: Number(p.orders),
    category: p.category
  }));

const pizzaClassic = cleanData("Classic");
const pizzaSpecialty = cleanData("Specialty");
const pizzaVegetarian = cleanData("Vegetarian");

const getPlotOptions = (data, title) => ({
  grid: true,
  inset: 10,
  x: { label: "Prix ($)", domain: [10, 28] },
  y: { label: "Nombre de commandes", domain: [0, 450] },
  marks: [
    Plot.frame({ stroke: "#e2e8f0" }),
    Plot.dot(data, {
      x: "price",
      y: "orders",
      fill: "category",
      r: 4,
      tip: true
    }),
  ],
});
---

<Layout title="TP2 - Page Unique & Slider (Pizzas)">
  <div class="max-w-4xl mx-auto p-8 bg-white rounded-2xl border border-slate-200/80 shadow-sm mt-12 mb-12">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 border-b border-slate-100 pb-6">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 border border-emerald-200/80 mb-2">
          <span>TP2</span>
          <span>•</span>
          <span>Page Unique & Slider</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Toutes les catégories (Slider Pizzas)
        </h1>
      </div>

      <a href="/" class="inline-flex items-center justify-center gap-1.5 text-xs font-semibold px-4 py-2.5 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200/60 transition shadow-sm self-start sm:self-auto">
        <span aria-hidden="true">←</span>
        <span>Retour Accueil</span>
      </a>
    </div>

    <nav class="flex flex-wrap items-center gap-2 mb-8 p-3 bg-slate-50/50 rounded-xl border border-slate-200/80 sticky top-4 z-50">
      <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-2">Aller à :</span>
      <a href="#classic" class="menu-item px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 font-medium text-sm transition [&.active]:bg-slate-900 [&.active]:text-white [&.active]:shadow-sm">Classic</a>
      <a href="#specialty" class="menu-item px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 font-medium text-sm transition [&.active]:bg-slate-900 [&.active]:text-white [&.active]:shadow-sm">Specialty</a>
      <a href="#vegetarian" class="menu-item px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 font-medium text-sm transition [&.active]:bg-slate-900 [&.active]:text-white [&.active]:shadow-sm">Vegetarian</a>
    </nav>

    <div class="slider-container">
      
      <div id="classic" class="item">
        <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8 w-full">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
            <div>
              <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Catégorie : Classic</h2>
              <p class="text-xs text-slate-500">Commandes selon le prix</p>
            </div>
            <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md border border-slate-200/80">{pizzaClassic.length} entrées</span>
          </div>
          <div class="overflow-x-auto">
            <PlotFigure options={getPlotOptions(pizzaClassic, "Catégorie Classic")} />
          </div>
        </section>
      </div>

      <div id="specialty" class="item">
        <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8 w-full">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
            <div>
              <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Catégorie : Specialty</h2>
              <p class="text-xs text-slate-500">Commandes selon le prix</p>
            </div>
            <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md border border-slate-200/80">{pizzaSpecialty.length} entrées</span>
          </div>
          <div class="overflow-x-auto">
            <PlotFigure options={getPlotOptions(pizzaSpecialty, "Catégorie Specialty")} />
          </div>
        </section>
      </div>

      <div id="vegetarian" class="item">
        <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8 w-full">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
            <div>
              <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Catégorie : Vegetarian</h2>
              <p class="text-xs text-slate-500">Commandes selon le prix</p>
            </div>
            <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md border border-slate-200/80">{pizzaVegetarian.length} entrées</span>
          </div>
          <div class="overflow-x-auto">
            <PlotFigure options={getPlotOptions(pizzaVegetarian, "Catégorie Vegetarian")} />
          </div>
        </section>
      </div>

    </div>

  </div>

  <script>
    const menuItems = document.querySelectorAll(".menu-item");
    const items = document.querySelectorAll(".item");

    console.log("menuItems", menuItems);
    console.log("items", items);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.getAttribute("id");
          const menuItem = document.querySelector(`.menu-item[href="#${id}"]`);
          
          if (entry.isIntersecting) {
            menuItem?.classList.add("active");
          } else {
            menuItem?.classList.remove("active");
          }
        });
      },
      { threshold: 0.5 },
    );

    items.forEach((item) => {
      observer.observe(item);
    });
  </script>
</Layout>

<style>
  .slider-container {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory; 
    scroll-behavior: smooth;
    align-items: center;
    gap: 2rem;
  }

  .item {
    min-width: 100%;
    scroll-snap-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
  }
  
  .slider-container::-webkit-scrollbar {
    display: none;
  }
</style>