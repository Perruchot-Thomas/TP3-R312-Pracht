---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import pizzaData from "../assets/pizza.json";
import '../styles/global.css';

const cleanData = (catName) => pizzaData
  .filter((p: any) => p.category === catName)
  .map((p: any) => ({ name: p.name, price: Number(p.price), orders: Number(p.orders), category: p.category }));

const pizzaClassic = cleanData("Classic");
const pizzaSpecialty = cleanData("Specialty");
const pizzaVegetarian = cleanData("Vegetarian");

const getPlotOptions = (data) => ({
  grid: true, inset: 10,
  x: { label: "Prix ($)", domain: [10, 28] },
  y: { label: "Nombre de commandes", domain: [0, 450] },
  marks: [Plot.frame({ stroke: "#e2e8f0" }), Plot.dot(data, { x: "price", y: "orders", fill: "category", r: 4, tip: true })],
});
---

<Layout title="TP3 - Ancres Pizzas">
  <div class="max-w-4xl mx-auto p-8 bg-white rounded-2xl border border-slate-200/80 shadow-sm mt-12 mb-12">
    
    <div class="flex items-center justify-between mb-8 border-b border-slate-100 pb-6">
      <h1 class="text-2xl font-extrabold text-slate-900">Slider Pizzas (Ancres)</h1>
      <a href="/" class="text-xs font-semibold px-4 py-2.5 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200/60 transition">← Retour</a>
    </div>

    <div class="mb-8 flex items-center gap-4">
      <label for="anchors-menu-pizza" class="text-sm font-semibold text-slate-700">Catégorie :</label>
      <select id="anchors-menu-pizza" class="px-4 py-2 rounded-lg bg-white border border-slate-200 shadow-sm focus:ring-2 focus:ring-emerald-500">
        <option value="#classic">Classic</option>
        <option value="#specialty">Specialty</option>
        <option value="#vegetarian">Vegetarian</option>
      </select>
    </div>

    <div class="slider-container flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-8 no-scrollbar">
      <div id="classic" class="item min-w-full snap-center"><PlotFigure options={getPlotOptions(pizzaClassic)} /></div>
      <div id="specialty" class="item min-w-full snap-center"><PlotFigure options={getPlotOptions(pizzaSpecialty)} /></div>
      <div id="vegetarian" class="item min-w-full snap-center"><PlotFigure options={getPlotOptions(pizzaVegetarian)} /></div>
    </div>
  </div>

  <script>
    document.querySelector("#anchors-menu-pizza")?.addEventListener("change", (evt) => {
      const value = (evt.target as HTMLSelectElement).value;
      location.hash = value;
    });
  </script>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>