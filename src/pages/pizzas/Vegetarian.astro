---
import Layout from '../../layouts/Layout.astro';
import GraphicCategory from '../../components/GraphicCategory.astro';
import '../../styles/global.css';
---

<Layout title="TP2 - Pizzas Vegetarian">
  <div class="max-w-4xl mx-auto p-8 bg-white rounded-2xl border border-slate-200/80 shadow-sm mt-12">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 border-b border-slate-100 pb-6">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 border border-emerald-200/80 mb-2">
          <span>TP2</span>
          <span>•</span>
          <span>Multi-pages (Pizzas)</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Focus sur la catégorie : Vegetarian
        </h1>
      </div>

      <a href="/" class="inline-flex items-center justify-center gap-1.5 text-xs font-semibold px-4 py-2.5 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200/60 transition shadow-sm self-start sm:self-auto">
        <span aria-hidden="true">←</span>
        <span>Retour Accueil</span>
      </a>
    </div>

    <div class="mb-8 p-4 bg-slate-50/50 rounded-xl border border-slate-200/80">
      <label for="category-select" class="block text-sm font-semibold text-slate-700 mb-2">Choisir une catégorie :</label>
      <select id="category-select" class="w-full sm:w-auto px-4 py-2.5 rounded-lg bg-white border border-slate-200 text-slate-800 font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
        <option value="Classic">Classic</option>
        <option value="Specialty">Specialty</option>
        <option value="Vegetarian" selected>Vegetarian</option>
      </select>
    </div>

    <main>
      <GraphicCategory categoryName="Vegetarian" />
    </main>

  </div>

  <script>
    document.querySelector("#category-select")?.addEventListener("change", (evt) => {
      const value = (evt.target as HTMLSelectElement).value;
      location.pathname = "/pizzas/" + value + "/";
    });
  </script>
</Layout>