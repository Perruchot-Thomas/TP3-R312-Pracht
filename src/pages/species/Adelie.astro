---
import Layout from '../../layouts/Layout.astro';
import GraphicSpecies from '../../components/GraphicSpecies.astro';
import '../../styles/global.css';
---

<Layout title="TP2 - Adelie">
  
  <div class="max-w-4xl mx-auto p-8 bg-white rounded-2xl border border-slate-200/80 shadow-sm mt-12">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 border-b border-slate-100 pb-6">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200/80 mb-2">
          <span>TP2</span>
          <span>•</span>
          <span>Multi-pages</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Focus sur l'espèce : Adelie
        </h1>
      </div>

      <a href="/" class="inline-flex items-center justify-center gap-1.5 text-xs font-semibold px-4 py-2.5 rounded-xl bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200/60 transition shadow-sm self-start sm:self-auto">
        <span aria-hidden="true">←</span>
        <span>Retour Accueil</span>
      </a>
    </div>

    <div class="mb-8 p-4 bg-slate-50/50 rounded-xl border border-slate-200/80">
      <label for="species-select" class="block text-sm font-semibold text-slate-700 mb-2">Choisir une espèce :</label>
      <select id="species-select" class="w-full sm:w-auto px-4 py-2.5 rounded-lg bg-white border border-slate-200 text-slate-800 font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="Adelie" selected>Adelie</option>
        <option value="Chinstrap">Chinstrap</option>
        <option value="Gentoo">Gentoo</option>
      </select>
    </div>

    <main>
      <GraphicSpecies speciesName="Adelie" />
    </main>

  </div>

  <script>
    document.querySelector("#species-select")?.addEventListener("change", (evt) => {
      const value = (evt.target as HTMLSelectElement).value;
      location.pathname = "/species/" + value + "/";
    });
  </script>
</Layout>